APP_ENV=development
POSTGRES_DB=slideai
POSTGRES_USER=slideai
POSTGRES_PASSWORD=local_dev_only
DATABASE_URL=postgresql+asyncpg://slideai:local_dev_only@postgres:5432/slideai
REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chroma
CHROMA_PORT=8000
FILE_STORAGE_ROOT=/var/lib/slideai/files
MODEL_CATALOG_PATH=/app/config/models.yaml
GENERATION_PROVIDER=openai_compatible
DEEPSEEK_BASE_URL=
DEEPSEEK_FLASH_MODEL_ID=
DEEPSEEK_PRO_MODEL_ID=
GLM_BASE_URL=
GLM_MODEL_ID=
DEEPSEEK_API_KEY=
GLM_API_KEY=
EMBEDDING_API_KEY=
MAX_AUTO_REVISIONS=2
EVALUATION_PASS_SCORE=85
DEMO_EVALUATION_SCORE=90
MAX_FILE_SIZE_BYTES=20971520
MODEL_RETRY_COUNT=2
MAX_FILES_PER_TASK=10
MAX_EXTRACTED_CHARS_PER_FILE=2000000
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
RETRIEVAL_TOP_K=6
EMBEDDING_PROVIDER=fake
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_ID=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=64
EMBEDDING_VERSION=v1
LOG_LEVEL=INFO
